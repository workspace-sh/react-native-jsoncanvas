{
  "name": "@workspace.sh/react-native-jsoncanvas",
  "version": "0.0.1",
  "description": "React Native renderer for JSON Canvas (.canvas) documents. Skia + Reanimated, with pan / pinch / fit / recenter controls.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "playground:start": "cd examples/playground && npx expo start --dev-client --port 8082",
    "playground:clear": "cd examples/playground && watchman watch-del-all && npx expo start --clear --port 8082",
    "playground:ios": "cd examples/playground && npx expo run:ios --port 8082",
    "playground:ios:device": "cd examples/playground && npx expo run:ios --device --port 8082",
    "playground:android": "cd examples/playground && npx expo run:android --port 8082",
    "playground:android:device": "cd examples/playground && npx expo run:android --device --port 8082",
    "playground:web": "cd examples/playground && npx expo start --web --port 8082"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.5.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=2.30.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.8.0"
  },
  "dependencies": {
    "hast-util-from-html": "^2.0.3",
    "js-yaml": "^4.1.1",
    "mdast-util-to-string": "^2.0.0",
    "remark-frontmatter": "^3.0.0",
    "remark-gfm": "^1.0.0",
    "remark-parse": "^9.0.0",
    "unified": "^9.2.2"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.81.2",
    "@react-native/typescript-config": "^0.81.2",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^3.0.15",
    "@types/node": "^20.19.41",
    "@types/react": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.10",
    "typescript": "^5.8.3"
  }
}
